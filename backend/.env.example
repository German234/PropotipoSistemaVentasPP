DB_SERVER=localhost
# (o DB_HOST=localhost)
DB_PORT=
DB_ENCRYPT=false
DB_TRUST_CERT=true
DB_NAME=BatallonAtlacatl
DB_USER=sa
DB_PASSWORD=cambiar
JWT_SECRET=cambiar-por-un-secreto-largo
PORT=3000
# Lote automático de contingencia (cierre del día): hora HH:mm y 1/0 para activarlo
CONTINGENCIA_LOTE_HORA=23:55
CONTINGENCIA_LOTE_ACTIVO=1
# Cola de consultas a MH (C3): 1 DTE en contingencia por turno, cada N segundos (10-3600)
CONSULTA_MH_ACTIVO=1
CONSULTA_MH_INTERVALO_SEG=60

# --- Seguridad (Fase 3) ---
# JWT_SECRET: 32+ caracteres aleatorios. Con NODE_ENV=production el servidor no arranca si es débil.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# NODE_ENV=production
# Orígenes que pueden llamar a la API desde otro dominio (coma). Vacío = http://localhost:PORT y http://127.0.0.1:PORT
CORS_ORIGENES=
# 1 = cookie de sesión con atributo Secure (obligatorio al servir por HTTPS)
COOKIE_SECURE=0
# Detrás de un proxy inverso: número de saltos o lista de IP (afecta req.ip y req.secure)
TRUST_PROXY=
# Límite de inicios de sesión fallidos: por usuario+IP, por IP, ventana y bloqueo en minutos
LOGIN_MAX_INTENTOS=5
LOGIN_MAX_INTENTOS_IP=20
LOGIN_VENTANA_MIN=15
LOGIN_BLOQUEO_MIN=15
# Credenciales de prueba en el login: 1 = mostrar, 0 = ocultar, vacío = solo si NODE_ENV no es production y se abre desde localhost
DEMO_CREDENCIALES=
